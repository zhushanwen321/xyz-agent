{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@real/execution/*": ["../../../extensions/universal/subagent-workflow/src/execution/*"],
      "@real/shared/*": ["../../../extensions/universal/subagent-workflow/src/shared/*"],
      "@real/orchestration/*": ["../../../extensions/universal/subagent-workflow/src/orchestration/*"]
    }
  },
  "include": ["extensions/**/*.ts", "packages/**/*.ts"]
}
