{
  "name": "xyz-agent",
  "version": "0.8.40",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @xyz-agent/electron dev",
    "build": "pnpm --filter @xyz-agent/electron build",
    "lint": "eslint .",
    "prepare": "bash .githooks/install-hooks.sh",
    "postinstall": "bash scripts/fix-node-pty-permissions.sh",
    "build:e2e": "pnpm --filter @xyz-agent/electron build:e2e",
    "test:e2e": "playwright test",
    "dev:smoke": "node scripts/dev-smoke.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:npm": "pnpm --filter @xyz-agent/extension-protocol build && changeset publish",
    "extensions:typecheck": "cd extensions && npx tsc --noEmit",
    "extensions:lint": "npx eslint extensions/",
    "extensions:test": "pnpm -r --filter '@zhushanwen/pi-*' test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "typescript": "^5.8",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "tsup>esbuild": "^0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-pty",
      "vue-demi"
    ]
  }
}
