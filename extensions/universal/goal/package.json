{
  "name": "@zhushanwen/pi-goal",
  "version": "0.9.1",
  "description": "Codex-style /goal command for Pi — persistent goal-driven autonomous loop with evidence-based completion, token/time budgets, blocked detection, and steering templates.",
  "type": "module",
  "main": "src/index.ts",
  "xyz-agent": {
    "role": "universal"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "extension",
    "goal",
    "autonomous",
    "loop"
  ],
  "license": "MIT",
  "files": [
    "src/",
    "index.ts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@zhushanwen/pi-pending-notifications": "workspace:*",
    "typebox": "*"
  },
  "dependencies": {
    "@xyz-agent/extension-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "fast-check": "^4.9.0",
    "vitest": "^4.1.8"
  }
}
