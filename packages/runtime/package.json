  },
  "devDependencies": {
    "@xyz-agent/extension-protocol": "workspace:*",
    "@xyz-agent/shared": "workspace:*",
    "@types/node": "^22",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^5.8",
    "vitest": "^4.1.6"
