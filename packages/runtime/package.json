{
  "name": "@xyz-agent/runtime",
  "version": "0.6.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "xyz-agent-runtime": "./dist/server.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
