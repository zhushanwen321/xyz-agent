# pnpm 配置
# ──────────────────────────────────────────────────────────────
# node-linker=isolated（pnpm 默认）：使用 symlink + .pnpm 隔离布局。
# builtin extension 打包内置依赖 pnpm deploy 的精确依赖收集，
# hoisted 模式会把整个 monorepo 依赖树拖进 deploy 产物（167M+）。
# 隔离模式让 deploy 只收集真实 dependencies 闭包。
# Electron 兼容性：runtime（tsup bundle）、renderer（vite bundle）、
# main（electron-builder files 拷贝）均自包含，不依赖 node_modules 结构。
# node-pty native module 经实测 electron-builder 正确处理 symlink。
node-linker=isolated

# 关闭 peer deps 自动安装。
# 原因：extensions/ 的 peerDeps（@earendil-works/pi-*、typebox）由 pi 进程运行时提供，
# 不应打进打包产物。auto-install-peers=true 会让 deploy 把 peerDeps 的传递闭包
# （pi-ai 的 LLM SDK 全家桶 150M+）全拖进来。
# 开发期类型由根 devDependencies 的 @earendil-works/pi-* 提供。
auto-install-peers=false

# 忽略 pnpm 对 peer deps 的严格检查（Electron 生态 peer dep 声明普遍不规范）
strict-peer-dependencies=false

# scoped 包（@xyz-agent/*、@zhushanwen/*）公开发布。
# changeset config 也有 access:public，这里是 npm publish 层面的双保险。
access=public

# .pnpm-store 位置（workspace 级共享，多 worktree 复用）
# 默认在 ~/.local/share/pnpm/store，不改
